---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import What from '../components/sections/What.astro';
import How from '../components/sections/How.astro';
import ThroughPhone from '../components/sections/ThroughPhone.astro';
import Decks from '../components/sections/Decks.astro';
import Premium from '../components/sections/Premium.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import ru from '../content/ru.json';

const t = ru;
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang="ru"
  footerTagline={t.footer.tagline}
>
  <Hero
    eyebrow={t.order.eyebrow}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    ctaLabel={t.hero.ctaPrimary}
    scrollLabel={t.hero.ctaSecondary}
  />
  <What headline={t.what.headline} cards={t.what.cards} />
  <How eyebrow={t.how.eyebrow} steps={t.how.steps} />
  <ThroughPhone eyebrow={t.phone.eyebrow} segments={t.phone.segments} />
  <Decks headline={t.decks.headline} caption={t.decks.caption} lang="ru" />
  <Premium headline={t.premium.headline} body={t.premium.body} />
  <FinalCta headline={t.cta.headline} ctaLabel={t.cta.button} />
</Layout>
