---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/hero/Hero.astro';
import What from '../../components/sections/What.astro';
import How from '../../components/sections/How.astro';
import Decks from '../../components/sections/Decks.astro';
import Order from '../../components/sections/Order.astro';
import Premium from '../../components/sections/Premium.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import en from '../../content/en.json';

const t = en;
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang="en"
  footerTagline={t.footer.tagline}
>
  <Hero
    eyebrow={t.order.eyebrow}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    ctaLabel={t.hero.ctaPrimary}
    scrollLabel={t.hero.ctaSecondary}
  />
  <What headline={t.what.headline} pills={t.what.pills} />
  <How eyebrow={t.how.eyebrow} steps={t.how.steps} />
  <Decks headline={t.decks.headline} caption={t.decks.caption} lang="en" />
  <Order eyebrow={t.order.eyebrow} headline={t.order.headline} body={t.order.body} />
  <Premium headline={t.premium.headline} body={t.premium.body} />
  <FinalCta headline={t.cta.headline} ctaLabel={t.cta.button} />
</Layout>
