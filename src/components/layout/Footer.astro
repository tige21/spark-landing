---
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';
import { APP_NAME, MERCHANT, LEGAL_LINKS, PRICING } from '../../config/site';
import Parallax from '../ui/Parallax.tsx';

interface Props {
  lang: 'ru' | 'en';
  tagline: string;
}
const { lang, tagline } = Astro.props;
const year = '2026';
---

<footer class="footer">
  <div class="footer-inner">
    <Parallax client:visible distance={36}>
      <Image
        src={engraving('colophon')}
        alt=""
        widths={[180, 320]}
        sizes="220px"
        class="colophon"
        loading="lazy"
      />
    </Parallax>
    <p class="tagline script">{tagline}</p>

    <section class="pricing">
      <h2 class="pricing-heading">{PRICING.heading[lang]}</h2>
      <ul class="pricing-list">
        {
          PRICING.items.map((item) => (
            <li>
              <span class="pricing-amount">{item.amount}</span>
              <span class="pricing-label">{item[lang]}</span>
            </li>
          ))
        }
      </ul>
      <p class="pricing-note">{PRICING.note[lang]}</p>
    </section>

    <nav class="legal-links">
      {LEGAL_LINKS.map((link) => <a href={link.href}>{link[lang]}</a>)}
    </nav>

    <address class="merchant">
      <span>{MERCHANT.name[lang]}</span>
      <span>{MERCHANT.innLabel[lang]} {MERCHANT.inn}</span>
      <a href={MERCHANT.phoneUrl}>{MERCHANT.phone}</a>
      <a href={`mailto:${MERCHANT.email}`}>{MERCHANT.email}</a>
    </address>

    <p class="legal">© {year} {APP_NAME}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .footer-inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .colophon {
    width: 220px;
    height: auto;
    opacity: 0.85;
  }
  .tagline {
    font-size: 1.5rem;
    margin: 0;
  }
  .pricing {
    margin-block-start: var(--space-lg);
    max-width: 46ch;
  }
  .pricing-heading {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--meta-strong);
    margin: 0 0 var(--space-xs);
  }
  .pricing-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .pricing-list li {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--meta-strong);
  }
  .pricing-amount {
    font-weight: 600;
  }
  .pricing-amount::after {
    content: ' - ';
  }
  .pricing-note {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: var(--meta-strong);
    opacity: 0.85;
    margin: var(--space-xs) 0 0;
  }
  .legal-links {
    margin-block-start: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
  .legal-links a,
  .merchant a {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--meta-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .merchant {
    margin-block-start: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-style: normal;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--meta-strong);
  }
  .legal {
    margin-block-start: var(--space-md);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--meta-strong);
    margin-bottom: 0;
  }
</style>
