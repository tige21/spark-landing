---
import Container from './Container.astro';

interface Props {
  id?: string;
  class?: string;
  narrow?: boolean;
  bleed?: boolean;
}
const { id, class: className = '', narrow = false, bleed = false } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <slot name="decor" />
  {bleed ? <slot /> : <Container narrow={narrow}><slot /></Container>}
</section>

<style>
  .section {
    position: relative;
    padding-block: clamp(var(--space-2xl), 4vw, 56px);
  }
</style>
