---
import Container from './Container.astro';
import TiltIn from '../ui/TiltIn.tsx';

interface Props {
  id?: string;
  class?: string;
  narrow?: boolean;
  bleed?: boolean;
  flat?: boolean;
}
const { id, class: className = '', narrow = false, bleed = false, flat = false } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <slot name="decor" />
  {
    flat ? (
      bleed ? <slot /> : <Container narrow={narrow}><slot /></Container>
    ) : (
      <TiltIn client:visible>
        {bleed ? <slot /> : <Container narrow={narrow}><slot /></Container>}
      </TiltIn>
    )
  }
</section>

<style>
  .section {
    position: relative;
    padding-block: clamp(var(--space-2xl), 4vw, 56px);
  }
  @media (max-width: 760px) {
    .section {
      padding-block: var(--space-xl);
    }
  }
</style>
