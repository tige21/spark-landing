---
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';
import { NAV_LINKS, APP_NAME } from '../../config/site';
import TelegramCTA from '../ui/TelegramCTA.tsx';

interface Props {
  lang: 'ru' | 'en';
}
const { lang } = Astro.props;

const altLang = lang === 'ru' ? 'en' : 'ru';
const altHref = lang === 'ru' ? '/en' : '/';
const ctaLabel = lang === 'ru' ? 'Открыть в Telegram' : 'Open in Telegram';
const homeHref = lang === 'ru' ? '/' : '/en';
---

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href={homeHref} aria-label={APP_NAME}>
      <Image src={engraving('logo-seal')} alt="" class="brand-logo" loading="eager" widths={[40, 80]} sizes="40px" />
      <span class="brand-text">
        <span class="brand-name">{APP_NAME}</span>
        <span class="brand-press script">Печатня «Искра»</span>
      </span>
    </a>

    <nav class="links" aria-label={lang === 'ru' ? 'Навигация' : 'Navigation'}>
      {NAV_LINKS.map((l) => (
        <a href={`#${l.id}`}>{lang === 'ru' ? l.ru : l.en}</a>
      ))}
    </nav>

    <div class="actions">
      <a class="lang" href={altHref} hreflang={altLang} aria-label={altLang.toUpperCase()}>
        {altLang.toUpperCase()}
      </a>
      <TelegramCTA label={ctaLabel} variant="primary" client:idle />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    backdrop-filter: saturate(1.1) blur(8px);
    background: color-mix(in srgb, var(--table) 82%, transparent);
    border-bottom: 1px solid var(--hairline);
  }
  .nav-inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--space-md) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-sm);
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .brand-press {
    font-size: 1.15rem;
    margin-top: 2px;
  }
  .links {
    display: flex;
    gap: var(--space-xl);
  }
  .links a {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--ink);
    text-decoration: none;
    opacity: 0.82;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .links a:hover {
    opacity: 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .lang {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: var(--meta-strong);
    text-decoration: none;
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-full);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .lang:hover {
    color: var(--ink);
    border-color: var(--meta);
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .brand-press {
      display: none;
    }
  }
</style>
