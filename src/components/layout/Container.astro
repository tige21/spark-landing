---
interface Props {
  class?: string;
  narrow?: boolean;
}
const { class: className = '', narrow = false } = Astro.props;
---

<div class:list={['container', { narrow }, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--space-xl);
  }
  .container.narrow {
    max-width: 760px;
  }
  @media (max-width: 600px) {
    .container {
      padding-inline: var(--space-lg);
    }
  }
</style>
