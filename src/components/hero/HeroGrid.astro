---
// Perspective-ish engraved grid for the hero: fine ink lines on cream, faded to nothing
// at the edges via a radial vignette mask, with a one-shot "grow-in" on load.
// Pure CSS (no JS); the global prefers-reduced-motion rule neutralises the animation.
---

<div class="hero-grid" aria-hidden="true">
  <div class="hero-grid-plane"></div>
</div>

<style>
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    perspective: 900px;
    -webkit-mask-image: radial-gradient(125% 95% at 50% 40%, #000 0%, rgba(0, 0, 0, 0.45) 48%, transparent 78%);
    mask-image: radial-gradient(125% 95% at 50% 40%, #000 0%, rgba(0, 0, 0, 0.45) 48%, transparent 78%);
  }
  .hero-grid-plane {
    position: absolute;
    inset: -20%;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    transform: rotateX(34deg) scale(1.15);
    transform-origin: 50% 30%;
    opacity: 0.55;
    animation: grid-in 1.1s var(--ease-out) both;
  }
  @keyframes grid-in {
    from { opacity: 0; transform: rotateX(34deg) scale(1.28); }
    to   { opacity: 0.55; transform: rotateX(34deg) scale(1.15); }
  }
  @media (max-width: 760px) {
    .hero-grid-plane { background-size: 40px 40px; transform: rotateX(40deg) scale(1.2); }
  }
</style>
