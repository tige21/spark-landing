---
import { existsSync } from 'node:fs';
import { getImage } from 'astro:assets';
import { engraving } from '../../assets/images';
import HeroScroll from './HeroScroll.tsx';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  scrollLabel: string;
}
const { eyebrow, title, subtitle, ctaLabel, scrollLabel } = Astro.props;

const spark = await getImage({ src: engraving('spark-mark'), width: 180, format: 'webp' });

// Posters = first frame of each sequence (matches the scroll-0 state); fall back
// to bg-celestial if a poster hasn't been generated yet.
const hasFrames = existsSync('public/hero-frames/hero/manifest.json');
const hasFramesMobile = existsSync('public/hero-frames/hero-mobile/manifest.json');
const bg = await getImage({ src: engraving('bg-celestial'), width: 1280, format: 'webp' });
const posterDesktop = existsSync('public/hero/hero-poster.webp') ? '/hero/hero-poster.webp' : bg.src;
const posterMobile = existsSync('public/hero/hero-poster-mobile.webp') ? '/hero/hero-poster-mobile.webp' : bg.src;
---

<HeroScroll
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  ctaLabel={ctaLabel}
  scrollLabel={scrollLabel}
  posterDesktop={posterDesktop}
  posterMobile={posterMobile}
  sparkSrc={spark.src}
  hasFrames={hasFrames}
  hasFramesMobile={hasFramesMobile}
  client:visible
/>
