---
import { existsSync } from 'node:fs';
import { getImage } from 'astro:assets';
import { engraving } from '../../assets/images';
import HeroScroll from './HeroScroll.tsx';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  scrollLabel: string;
}
const { eyebrow, title, subtitle, ctaLabel, scrollLabel } = Astro.props;

const posterDesktop = await getImage({ src: engraving('bg-celestial'), width: 1600, format: 'webp' });
const posterMobile = await getImage({ src: engraving('bg-celestial'), width: 820, format: 'webp' });
const spark = await getImage({ src: engraving('spark-mark'), width: 180, format: 'webp' });

// Scroll-scrub sequences are optional — fall back to the poster until they exist.
const hasFrames = existsSync('public/hero-frames/hero/manifest.json');
const hasFramesMobile = existsSync('public/hero-frames/hero-mobile/manifest.json');
---

<HeroScroll
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  ctaLabel={ctaLabel}
  scrollLabel={scrollLabel}
  posterDesktop={posterDesktop.src}
  posterMobile={posterMobile.src}
  sparkSrc={spark.src}
  hasFrames={hasFrames}
  hasFramesMobile={hasFramesMobile}
  client:load
/>
