---
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';
import HeroScene from './HeroScene.tsx';
import HeroContentMotion from './HeroContentMotion.tsx';
import TelegramCTA from '../ui/TelegramCTA.tsx';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  scrollLabel: string;
}
const { eyebrow, title, subtitle, ctaLabel, scrollLabel } = Astro.props;
---

<section class="hero">
  <Image
    src={engraving('bg-celestial')}
    alt=""
    class="poster"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920]}
    sizes="100vw"
  />
  <div class="scrim"></div>
  <HeroScene client:only="react" />

  <div class="hero-content">
    <HeroContentMotion client:visible>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="t-display">{title}</h1>
      <p class="t-lead subtitle">{subtitle}</p>
      <div class="hero-cta">
        <TelegramCTA label={ctaLabel} variant="hero" client:idle />
      </div>
      <a class="scroll-cue" href="#how">{scrollLabel}</a>
    </HeroContentMotion>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    z-index: var(--z-bg);
    mix-blend-mode: multiply;
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      120% 80% at 50% 45%,
      color-mix(in srgb, var(--table) 35%, transparent) 0%,
      color-mix(in srgb, var(--table) 70%, transparent) 70%,
      var(--table) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: var(--z-content);
    text-align: center;
    max-width: 820px;
    padding: var(--space-3xl) var(--space-xl);
  }
  .hero-content h1 {
    margin: var(--space-md) 0 var(--space-lg);
  }
  .subtitle {
    max-width: 30ch;
    margin-inline: auto;
  }
  .hero-cta {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: center;
  }
  .scroll-cue {
    display: inline-block;
    margin-top: var(--space-2xl);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--meta);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .scroll-cue::after {
    content: '↓';
    display: block;
    margin-top: var(--space-xs);
    animation: bob 1.8s var(--ease-in-out) infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }
</style>
