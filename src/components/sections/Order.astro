---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import StampReveal from '../ui/StampReveal.tsx';
import Parallax from '../ui/Parallax.tsx';
import SectionDecor from '../ui/SectionDecor.astro';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  eyebrow: string;
  headline: string;
  body: string;
}
const { eyebrow, headline, body } = Astro.props;
---

<Section id="order" class="order">
  <SectionDecor
    slot="decor"
    layers={[
      { name: 'postmark', width: 180, top: '12%', left: '-2%', speed: 0.6, rotate: -6, opacity: 0.07 },
    ]}
  />
  <div class="grid">
    <div class="copy">
      <StampReveal client:visible>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="t-h1">{headline}</h2>
      </StampReveal>
      <Reveal client:visible delay={0.12}>
        <p class="t-lead">{body}</p>
      </Reveal>
    </div>
    <div class="art">
      <Parallax client:visible distance={70}>
        <Image src={engraving('phase-print')} alt="" widths={[360, 620]} sizes="(max-width: 800px) 80vw, 480px" loading="lazy" />
      </Parallax>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
  }
  .copy :global(.t-lead) {
    margin-top: var(--space-md);
  }
  .art :global(img) {
    width: 100%;
    height: auto;
    max-width: 480px;
    margin-inline: auto;
    display: block;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .art {
      order: -1;
    }
  }
</style>
