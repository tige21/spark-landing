---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import StampReveal from '../ui/StampReveal.tsx';
import SealPress from '../ui/SealPress.tsx';
import PostalRoute from './PostalRoute.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Step {
  title: string;
  body: string;
}
interface Props {
  eyebrow: string;
  steps: Step[];
}
const { eyebrow, steps } = Astro.props;

const heroes = ['onb-postoffice', 'onb-cards', 'onb-talk', 'seal-approved'];
---

<Section id="how" class="how">
  <Reveal client:visible>
    <p class="eyebrow">{eyebrow}</p>
  </Reveal>

  <div class="steps-wrap">
    <div class="route-band">
      <PostalRoute client:visible />
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <StampReveal
            client:visible
            delay={0.12 * i}
            style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 'var(--space-sm)' }}
          >
            <div class="art">
              {i === steps.length - 1 ? (
                <SealPress client:visible style={{ width: '100%', height: '100%' }}>
                  <Image src={engraving(heroes[i] ?? 'seal')} alt="" widths={[160, 260]} sizes="200px" loading="lazy" />
                </SealPress>
              ) : (
                <Image src={engraving(heroes[i] ?? 'seal')} alt="" widths={[160, 260]} sizes="200px" loading="lazy" />
              )}
              <span class="num">{i + 1}</span>
            </div>
            <h3 class="t-h3">{s.title}</h3>
            <p class="t-caption">{s.body}</p>
          </StampReveal>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .how {
    text-align: center;
  }
  /* Section-class text-align doesn't reach content (the <section> is rendered by
     Section.astro, so How's scope can't tag it). Center the owned elements. */
  .eyebrow,
  .steps-wrap {
    text-align: center;
  }
  .steps-wrap {
    position: relative;
    margin-top: var(--space-xl);
  }
  .route-band {
    position: absolute;
    top: 28px;
    left: 2%;
    right: 2%;
    height: 150px;
    z-index: 0;
    pointer-events: none;
  }
  .steps {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2xl);
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .art {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .num {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-script);
    font-size: 2rem;
    color: var(--wine);
  }
  .step p {
    max-width: 24ch;
    margin-inline: auto;
  }
  @media (max-width: 880px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .route-band {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
      max-width: 320px;
      margin-inline: auto;
      gap: var(--space-lg);
    }
    .steps-wrap {
      margin-top: var(--space-lg);
    }
    .art {
      width: 150px;
      height: 150px;
    }
  }
</style>
