---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import StampReveal from '../ui/StampReveal.tsx';
import SectionDecor from '../ui/SectionDecor.astro';
import PlayCTA from '../ui/PlayCTA.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  ctaLabel: string;
  ctaTelegramLabel: string;
}
const { headline, ctaLabel, ctaTelegramLabel } = Astro.props;
---

<Section class="final" narrow>
  <SectionDecor
    slot="decor"
    layers={[
      { name: 'spark-mark', width: 160, top: '12%', left: '4%', speed: 0.7, rotate: -12, opacity: 0.08 },
      { name: 'postmark', width: 190, bottom: '10%', right: '2%', speed: 0.5, rotate: 7, opacity: 0.07 },
    ]}
  />
  <StampReveal client:visible>
    <Image src={engraving('seal')} alt="" class="seal" loading="lazy" widths={[200, 360]} sizes="260px" />
  </StampReveal>
  <StampReveal client:visible delay={0.12}>
    <h2 class="t-display headline">{headline}</h2>
  </StampReveal>
  <Reveal client:visible delay={0.24}>
    <div class="cta">
      <PlayCTA label={ctaLabel} target="browser" variant="seal" client:visible />
      <PlayCTA label={ctaTelegramLabel} target="telegram" variant="seal" client:visible />
    </div>
  </Reveal>
</Section>

<style>
  .final {
    text-align: center;
    position: relative;
  }
  .seal {
    width: 130px;
    height: auto;
    margin: 0 auto var(--space-lg);
    display: block;
    opacity: 0.95;
    animation: seal-breathe 5s var(--ease-in-out) infinite;
    transform-origin: center;
  }
  @keyframes seal-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.035); }
  }
  .headline {
    max-width: 18ch;
    margin-inline: auto;
    text-align: center;
  }
  .cta {
    margin-top: var(--space-2xl);
    /* Equal columns — see .hero-cta: sized to their own labels the two buttons
       came out 19px apart, which stacked on a phone reads as a mistake.
       No max-width here: `1fr` is minmax(auto, 1fr), and with nowrap labels the
       auto minimum is the label's own width, so a container narrower than both
       labels plus the gap silently drops back to unequal content-sized columns.
       Capping this at 560px did exactly that (the pair needs 631px). */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-md);
  }
  @media (max-width: 760px) {
    .cta {
      grid-auto-flow: row;
    }
  }
</style>
