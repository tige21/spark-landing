---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import StampReveal from '../ui/StampReveal.tsx';
import SectionDecor from '../ui/SectionDecor.astro';
import TelegramCTA from '../ui/TelegramCTA.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  ctaLabel: string;
}
const { headline, ctaLabel } = Astro.props;
---

<Section class="final" narrow>
  <SectionDecor
    slot="decor"
    layers={[
      { name: 'spark-mark', width: 160, top: '12%', left: '4%', speed: 0.7, rotate: -12, opacity: 0.08 },
      { name: 'postmark', width: 190, bottom: '10%', right: '2%', speed: 0.5, rotate: 7, opacity: 0.07 },
    ]}
  />
  <StampReveal client:visible>
    <Image src={engraving('seal')} alt="" class="seal" loading="lazy" widths={[200, 360]} sizes="260px" />
  </StampReveal>
  <StampReveal client:visible delay={0.12}>
    <h2 class="t-display headline">{headline}</h2>
  </StampReveal>
  <Reveal client:visible delay={0.24}>
    <div class="cta">
      <TelegramCTA label={ctaLabel} variant="seal" client:visible />
    </div>
  </Reveal>
</Section>

<style>
  .final {
    text-align: center;
    position: relative;
  }
  .seal {
    width: 130px;
    height: auto;
    margin: 0 auto var(--space-lg);
    display: block;
    opacity: 0.95;
    animation: seal-breathe 5s var(--ease-in-out) infinite;
    transform-origin: center;
  }
  @keyframes seal-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.035); }
  }
  .headline {
    max-width: 18ch;
    margin-inline: auto;
  }
  .cta {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: center;
  }
</style>
