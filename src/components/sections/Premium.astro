---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import StampReveal from '../ui/StampReveal.tsx';
import Parallax from '../ui/Parallax.tsx';
import SectionDecor from '../ui/SectionDecor.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  body: string;
}
const { headline, body } = Astro.props;
---

<Section class="premium">
  <SectionDecor
    slot="decor"
    layers={[
      { name: 'spark-mark', width: 140, top: '14%', right: '4%', speed: 0.7, rotate: 10, opacity: 0.08 },
    ]}
    client:visible
  />
  <div class="grid">
    <div class="art">
      <Parallax client:visible distance={70}>
        <Image src={engraving('paywall-crest')} alt="" widths={[320, 560]} sizes="(max-width: 800px) 70vw, 420px" loading="lazy" />
      </Parallax>
    </div>
    <div class="copy">
      <StampReveal client:visible>
        <h2 class="t-h1">{headline}</h2>
      </StampReveal>
      <Reveal client:visible delay={0.12}>
        <p class="t-lead">{body}</p>
      </Reveal>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-3xl);
  }
  .copy :global(.t-lead) {
    margin-top: var(--space-md);
  }
  .art :global(img) {
    width: 100%;
    height: auto;
    max-width: 420px;
    margin-inline: auto;
    display: block;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .art {
      order: -1;
    }
  }
</style>
