---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import DecksShelf from './DecksShelf.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  caption: string;
  lang: 'ru' | 'en';
}
const { headline, caption, lang } = Astro.props;
---

<Section id="decks" class="decks">
  <Image src={engraving('bg-decks')} alt="" class="crest" loading="lazy" widths={[600, 1000]} sizes="900px" />
  <div class="decks-head">
    <Reveal client:visible>
      <h2 class="t-h1">{headline}</h2>
      <p class="t-lead caption">{caption}</p>
    </Reveal>
  </div>
  <DecksShelf lang={lang} client:visible />
</Section>

<style>
  .decks {
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  .crest {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(900px, 90%);
    height: auto;
    opacity: 0.12;
    z-index: var(--z-bg);
    pointer-events: none;
  }
  .decks-head {
    position: relative;
    z-index: var(--z-content);
  }
  .caption {
    max-width: 32ch;
    margin-inline: auto;
  }
</style>

<style is:global>
  .deck-grid {
    position: relative;
    z-index: var(--z-content);
    list-style: none;
    margin: var(--space-3xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }
  .deck-card {
    width: 100%;
    height: 100%;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-md);
    padding: var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    font: inherit;
    text-align: center;
    transition: box-shadow var(--dur-normal) var(--ease-out);
  }
  .deck-card.is-active {
    box-shadow: var(--shadow-float);
    border-color: color-mix(in srgb, var(--wine) 35%, var(--hairline));
  }
  .deck-card img {
    width: 120px;
    height: 120px;
  }
  .deck-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .deck-sample {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--meta);
    max-width: 26ch;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--dur-slow) var(--ease-out), opacity var(--dur-normal) var(--ease-out);
  }
  .deck-sample.show {
    max-height: 120px;
    opacity: 1;
  }
  @media (max-width: 860px) {
    .deck-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .deck-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
