---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import Parallax from '../ui/Parallax.tsx';
import DecksShelf from './DecksShelf.tsx';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  caption: string;
  lang: 'ru' | 'en';
}
const { headline, caption, lang } = Astro.props;
---

<Section id="decks" class="decks">
  <div class="crest-clip" aria-hidden="true">
    <div class="crest-holder">
      <Parallax client:visible distance={0} rotate={22}>
        <Image src={engraving('bg-decks')} alt="" class="crest" loading="lazy" widths={[600, 1000]} sizes="900px" />
      </Parallax>
    </div>
  </div>
  <div class="decks-head">
    <Reveal client:visible>
      <h2 class="t-h1">{headline}</h2>
      <p class="t-lead caption">{caption}</p>
    </Reveal>
  </div>
  <DecksShelf lang={lang} client:visible />
</Section>

<style>
  .decks {
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  .crest-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: var(--z-bg);
    pointer-events: none;
  }
  .crest-holder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(900px, 90%);
  }
  .crest {
    width: 100%;
    height: auto;
    opacity: 0.12;
    display: block;
  }
  .decks-head {
    position: relative;
    z-index: var(--z-content);
  }
  .caption {
    max-width: 32ch;
    margin-inline: auto;
  }
</style>

<style is:global>
  .deck-grid {
    position: relative;
    z-index: var(--z-content);
    list-style: none;
    margin: var(--space-3xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }
  .deck-card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
    transition: box-shadow var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out);
  }
  .deck-card:hover {
    box-shadow: var(--shadow-float);
    border-color: color-mix(in srgb, var(--wine) 35%, var(--hairline));
  }
  .deck-card img {
    width: 110px;
    height: 110px;
  }
  .deck-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin-top: var(--space-xs);
  }
  .deck-sample {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--meta);
    max-width: 26ch;
  }
  @media (max-width: 860px) {
    .deck-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .deck-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
