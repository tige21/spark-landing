---
import Section from '../layout/Section.astro';
import Reveal from '../ui/Reveal.tsx';
import DecksShelf from './DecksShelf.astro';
import { Image } from 'astro:assets';
import { engraving } from '../../assets/images';

interface Props {
  headline: string;
  caption: string;
  lang: 'ru' | 'en';
}
const { headline, caption, lang } = Astro.props;
---

<Section id="decks" class="decks" flat>
  <div class="crest-clip" aria-hidden="true">
    <div class="crest-holder">
      <Image src={engraving('bg-decks')} alt="" class="crest" loading="lazy" widths={[600, 1000]} sizes="900px" />
    </div>
  </div>
  <div class="decks-head">
    <Reveal client:visible className="decks-enter">
      <h2 class="t-h1">{headline}</h2>
      <p class="t-lead caption">{caption}</p>
    </Reveal>
  </div>
  <DecksShelf lang={lang} />
</Section>

<style>
  .decks {
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  /* Confine the engraving to the cards region (below the heading) and clip it
     there, so it backs the deck grid instead of the title and never spills.
     The crest is STATIC on purpose. Scroll-rotated it was a 1194x2312 device-px
     composited layer sitting UNDER the nine cards, and everything painting over
     a composited layer has to be composited too — the grid and the heading were
     dragged onto their own layers and repainted for the whole scroll. At 12%
     opacity the +-4deg it used to travel was invisible; the compositing was not. */
  .crest-clip {
    position: absolute;
    top: clamp(220px, 24vw, 360px);
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    z-index: var(--z-bg);
    pointer-events: none;
  }
  .crest-holder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(520px, 56%);
  }
  .crest {
    width: 100%;
    height: auto;
    opacity: 0.12;
    display: block;
  }
  .decks-head {
    position: relative;
    z-index: var(--z-content);
    text-align: center;
  }
  .caption {
    max-width: 32ch;
    margin-inline: auto;
  }
</style>

<style is:global>
  /* Stronger, clearly-visible entrance for the "Девять колод" heading — a longer
     fade + bigger rise than the default .reveal, because this heading is the
     page's first hard proof and has to register. Scoped to .decks-enter so other
     reveals are untouched; `:not(.is-in)` keeps it from fighting the global
     is-in reset. */
  .reveal.decks-enter {
    transition-duration: 0.7s;
  }
  .reveal.decks-enter:not(.is-in) {
    transform: translateY(34px);
  }
  .deck-grid {
    position: relative;
    z-index: var(--z-content);
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }
  /* No `perspective` and no entrance: the staggered rotateX fly-in kept a 3D
     rendering context alive on the grid AND on all nine cells for the life of
     the page — ten standing contexts in one section, which is what made this
     block stutter under the scroll. The cards are a reference list; they read
     fine arriving with the section. */
  .deck-cell {
    list-style: none;
  }
  .deck-card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
    cursor: pointer;
    /* Hover answers with ink only — no transform, so the card never needs a
       layer. The tilt-lift this replaces also had a JS partner (pointer handlers
       faking :hover for touch), and dropping both is what let the grid stop
       being a hydrated island. */
    transition: box-shadow var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out);
  }
  .deck-card:hover,
  .deck-card:active {
    box-shadow: var(--shadow-float);
    border-color: color-mix(in srgb, var(--wine) 35%, var(--hairline));
  }
  .deck-card img {
    width: 110px;
    height: 110px;
  }
  .deck-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin-top: var(--space-xs);
  }
  .deck-sample {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--meta);
    max-width: 26ch;
  }
  @media (max-width: 860px) {
    .deck-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .deck-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
