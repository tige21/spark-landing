# Hero scroll-scrub frames are tracked via Git LFS (see .gitattributes) so the
# CI cloud build ships them — NOT gitignored. A frames-less build + rsync --delete
# would wipe them off the live mirrors.

# local frame backups / originals (P6 retone) — not build inputs, stay ignored
public/hero-frames-orig/
public/hero-orig/

public/hero-orig/
src/assets/engravings-orig/

# code intelligence indexes (local only)
.serena/
.codegraph/
